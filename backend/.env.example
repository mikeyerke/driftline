GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
MODEL_NAME=gemini-3.5-flash
DRIFTLINE_DEMO_MODE=true
DRIFTLINE_PERSISTENCE=memory
FIRESTORE_DATABASE=(default)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DRIFTLINE_AGENT_MAX_CALLS=10
DRIFTLINE_AGENT_WINDOW_SECONDS=3600
DRIFTLINE_DEMO_MAX_MUTATIONS=30
DRIFTLINE_DEMO_WINDOW_SECONDS=3600
# Optional Jira connector; keep disabled unless these values come from a
# least-privilege Secret Manager binding scoped to one Atlassian project.
DRIFTLINE_JIRA_ENABLED=false
DRIFTLINE_JIRA_BASE_URL=https://your-site.atlassian.net
DRIFTLINE_JIRA_EMAIL=
DRIFTLINE_JIRA_TOKEN=
DRIFTLINE_JIRA_PROJECT_KEY=
DRIFTLINE_JIRA_ISSUE_TYPE=Task
